---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import type { ImageMetadata } from 'astro';
import ScreenshotViewer from '../components/ScreenshotViewer.astro';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description = site.description,
  image = { src: '/social-card.png', width: 1200, height: 630 },
  imageAlt = 'Joel deHoog — Software Developer. Full-stack applications, backend systems, and AI integration.',
} = Astro.props;

// Avoid publishing localhost canonical/social URLs before a production domain is chosen.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageURL = Astro.site ? new URL(image.src, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F8F9FA" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {socialImageURL && <meta property="og:image" content={socialImageURL} />}
    {socialImageURL && <meta property="og:image:width" content={String(image.width)} />}
    {socialImageURL && <meta property="og:image:height" content={String(image.height)} />}
    {socialImageURL && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}
    {socialImageURL && <meta name="twitter:image:alt" content={imageAlt} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScreenshotViewer />
  </body>
</html>
