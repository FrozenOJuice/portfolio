---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-showcase" aria-labelledby={`${project.id}-title`}>
  <div class="project-heading">
    <div>
      <p class="project-context">{project.context}</p>
      <h3 id={`${project.id}-title`}>{project.name}</h3>
    </div>
    {project.sourceUrl && (
      <a class="text-link project-source" href={project.sourceUrl} aria-label={`View on GitHub: ${project.name}`}>
        View on GitHub <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>

  <figure>
    <a class={`project-image-link ${project.id}-image`} href={project.image.src} aria-label={`Open full-size ${project.name} screenshot`}>
      <Image
        src={project.image}
        alt={project.imageAlt}
        widths={[480, 768, 1100, 1600]}
        sizes="(max-width: 1148px) calc(100vw - 48px), 1100px"
        format="webp"
        quality={85}
        loading="lazy"
        decoding="async"
      />
      <span class="image-expand" aria-hidden="true">View full size ↗</span>
    </a>
    <figcaption>
      <span>{project.caption}</span>
      {project.credit && <a href={project.credit.url}>{project.credit.label} <span aria-hidden="true">↗</span></a>}
    </figcaption>
  </figure>

  <div class="project-details">
    <div>
      <p class="project-description">{project.description}</p>
      <ul class="technology-list" aria-label={`${project.name} technologies`}>
        {project.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    </div>
    <div class="project-highlights">
      <h4>{project.highlightsTitle}</h4>
      <ul>
        {project.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </div>
  </div>
</article>
