---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import Icon from './Icon.astro';
import SocialLink from './SocialLink.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-showcase" aria-labelledby={`${project.id}-title`}>
  <figure>
    <a class="project-screenshot" href={project.image.src} data-viewer data-viewer-title={project.name} data-viewer-alt={project.imageAlt} data-viewer-caption={project.caption} aria-label={`View screenshot: ${project.name}`}>
      <span class="project-image-link">
        <Image
          src={project.image}
          alt={project.imageAlt}
          widths={[360, 640, 960, 1440]}
          sizes="(min-width: 1148px) 351px, (min-width: 1024px) calc((100vw - 96px) / 3), (min-width: 700px) calc((100vw - 72px) / 2), calc(100vw - 40px)"
          format="webp"
          quality={85}
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="screenshot-action"><Icon name="expand" size={17} /> View screenshot</span>
    </a>
    <figcaption class="sr-only">{project.caption}</figcaption>
  </figure>

  <div class="project-body">
    <div class="project-title-row">
      <h3 id={`${project.id}-title`}><a class="project-title-link" href={`/projects/${project.id}/`}>{project.name}</a></h3>
      {project.sourceUrl && <SocialLink kind="github" href={project.sourceUrl} label={`${project.name} on GitHub`} />}
    </div>
    <p class="project-description">
      {project.description}
      {project.credit && <a class="project-credit" href={project.credit.url}>{project.credit.label}</a>}
    </p>
    <p class="project-technologies" aria-label={`${project.name} technologies`}>{project.technologies.join(' · ')}</p>
    <a class="project-case-link" href={`/projects/${project.id}/`} aria-label={`Read case study: ${project.name}`}>
      Case study <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
