---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  hero?: boolean;
}

const { image, alt, caption, hero = false } = Astro.props;
---

<figure class:list={['case-image', { 'case-image-hero': hero }]}>
  <a class="case-image-link" href={image.src} data-viewer data-viewer-title={caption} data-viewer-alt={alt} data-viewer-caption={caption} aria-label={`View screenshot: ${caption}`}>
    <Image
      src={image}
      alt={alt}
      widths={[360, 640, 960, 1440]}
      sizes={hero ? '(min-width: 948px) 900px, calc(100vw - 48px)' : '(min-width: 828px) 780px, calc(100vw - 40px)'}
      format="webp"
      quality={85}
      loading={hero ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="screenshot-action"><Icon name="expand" size={17} /> View screenshot</span>
  </a>
  <figcaption>{caption}</figcaption>
</figure>
