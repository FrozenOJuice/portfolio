---
import { site } from '../data/site';
---

<header class="site-header">
  <div class="content-width header-inner">
    <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
      Joel deHoog<span aria-hidden="true">.</span>
    </a>
    <nav aria-label="Main navigation">
      <ul class="navigation-list">
        <li><a href="/#projects">Projects</a></li>
        <li><a href="/#about">About</a></li>
        <li>
          {site.resume ? (
            <a href={site.resume}>Resume <span aria-hidden="true">↗</span></a>
          ) : (
            <span class="unavailable-link" aria-disabled="true" title="Resume PDF coming soon">
              Resume <span class="soon-label">soon</span>
            </span>
          )}
        </li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>
