---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="content-width footer-inner">
    <p>© {new Date().getUTCFullYear()} {site.name}</p>
    <nav aria-label="Footer navigation">
      <ul class="footer-links">
        <li><a href={site.github}>GitHub <span aria-hidden="true">↗</span></a></li>
        <li><a href={site.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></li>
        <li><a href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>
  </div>
</footer>
