---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { projects } from '../data/projects';
import { site, skillGroups } from '../data/site';
import SocialLink from '../components/SocialLink.astro';
---

<BaseLayout title={site.title}>
  <section class="hero content-width" aria-labelledby="hero-title">
    <div>
      <h1 id="hero-title">Joel deHoog</h1>
      <p class="hero-profession">Software Developer</p>
      <p class="hero-introduction">I build practical web applications, from the interface to the backend.</p>
    </div>
    <div class="hero-background">
      <p>Recent graduate · BSc in Computer Science<br />UBC Okanagan, 2026</p>
      <p>Open to software developer roles.</p>
      <div class="hero-links">
        <SocialLink kind="github" href={site.github} />
        <SocialLink kind="linkedin" href={site.linkedin} />
        <SocialLink kind="email" href={`mailto:${site.email}`} label={`Email ${site.email}`} />
        {site.resume && <a href={site.resume}>Resume <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </section>

  <section id="projects" class="projects-section content-width" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">Projects</h2>
    </div>
    <div class="projects-list">
      {projects.map((project) => <ProjectShowcase project={project} />)}
    </div>
  </section>

  <div class="profile-sections content-width">
    <section id="about" aria-labelledby="about-title">
      <h2 id="about-title">About</h2>
      <p>I completed my Computer Science degree in three years and bring a strong work ethic to independent and team projects. My work spans application interfaces, backend services, and integrations, including a team capstone for exam grading. I enjoy learning new tools and building software that solves practical problems.</p>
    </section>
    <section aria-labelledby="skills-title">
      <h2 id="skills-title">Technical skills</h2>
      <dl class="skills-grid">
        {skillGroups.map((group) => (
          <div>
            <dt>{group.title}</dt>
            <dd>{group.skills.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>

  <section id="contact" class="contact-section content-width" aria-labelledby="contact-title">
    <h2 id="contact-title">Contact</h2>
    <div class="contact-links">
      <SocialLink kind="github" href={site.github} />
      <SocialLink kind="linkedin" href={site.linkedin} />
      <SocialLink kind="email" href={`mailto:${site.email}`} label={`Email ${site.email}`} />
    </div>
  </section>
</BaseLayout>
